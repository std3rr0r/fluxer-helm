{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "global",
    "image",
    "secrets",
    "postgres",
    "valkey",
    "httpRoute"
  ],
  "properties": {
    "global": {
      "type": "object",
      "required": [
        "domain",
        "publicScheme",
        "publicPort"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$",
          "description": "Public hostname of the instance, e.g. chat.example.com"
        },
        "publicScheme": {
          "type": "string",
          "enum": [
            "http",
            "https"
          ]
        },
        "publicPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "vapid": {
          "type": "object",
          "properties": {
            "publicKey": {
              "type": "string"
            },
            "privateKey": {
              "type": "string"
            },
            "email": {
              "type": "string",
              "minLength": 3
            }
          }
        },
        "livekitApiKey": {
          "type": "string",
          "minLength": 1
        },
        "klipyApiKey": {
          "type": "string"
        }
      }
    },
    "postgres": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "clusterName": {
          "type": "string"
        },
        "instances": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "imageName": {
          "type": "string"
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "$ref": "#/definitions/storage"
        },
        "walStorage": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "$ref": "#/definitions/quantity"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extraSpec": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "username": {
              "type": "string"
            },
            "passwordSecret": {
              "type": "string"
            },
            "passwordSecretKey": {
              "type": "string"
            },
            "ssl": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "shards": {
          "type": "integer",
          "minimum": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "image": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^_]"
        },
        "password": {
          "type": "string"
        },
        "permissions": {
          "type": "string",
          "minLength": 1
        },
        "prometheus": {
          "type": "boolean"
        },
        "tlsSecretName": {
          "type": "string"
        },
        "storage": {
          "type": "object",
          "properties": {
            "size": {
              "$ref": "#/definitions/quantity"
            },
            "storageClass": {
              "type": "string"
            },
            "reclaimPolicy": {
              "type": "string",
              "enum": [
                "Retain",
                "Delete"
              ]
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "config": {
          "type": "object"
        },
        "scheduling": {
          "type": "object"
        },
        "extraSpec": {
          "type": "object"
        },
        "external": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          }
        }
      }
    },
    "nats": {
      "$ref": "#/definitions/backingService"
    },
    "meilisearch": {
      "$ref": "#/definitions/backingService"
    },
    "garage": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "replication": {
          "type": "object",
          "properties": {
            "factor": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "storage": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "metadata": {
              "$ref": "#/definitions/storage"
            },
            "data": {
              "$ref": "#/definitions/storage"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "extraSpec": {
          "type": "object"
        },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
          }
        }
      }
    },
    "livekit": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "rtc": {
          "type": "object",
          "properties": {
            "tcpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "udpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "useExternalIP": {
              "type": "boolean"
            },
            "stunServers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "media": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "LoadBalancer",
                "NodePort",
                "hostNetwork",
                "none"
              ]
            },
            "annotations": {
              "type": "object"
            },
            "nodePortTCP": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            },
            "nodePortUDP": {
              "type": "integer",
              "minimum": 30000,
              "maximum": 32767
            }
          }
        }
      }
    },
    "email": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": "string",
          "enum": [
            "none",
            "smtp"
          ]
        },
        "fromEmail": {
          "type": "string"
        },
        "fromName": {
          "type": "string"
        },
        "smtp": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "username": {
              "type": "string"
            },
            "password": {
              "type": "string"
            },
            "secure": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "captcha": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "provider": {
          "type": "string"
        }
      }
    },
    "discovery": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "svcShardCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "services": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "$ref": "#/definitions/appService"
        },
        "worker": {
          "$ref": "#/definitions/appService"
        },
        "gateway": {
          "allOf": [
            {
              "$ref": "#/definitions/appService"
            },
            {
              "properties": {
                "logLevel": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "mediaProxy": {
          "$ref": "#/definitions/appService"
        },
        "staticProxy": {
          "$ref": "#/definitions/appService"
        },
        "appProxy": {
          "$ref": "#/definitions/appService"
        },
        "admin": {
          "$ref": "#/definitions/appService"
        },
        "snowflakes": {
          "$ref": "#/definitions/routerService"
        },
        "users": {
          "$ref": "#/definitions/routerService"
        },
        "messages": {
          "$ref": "#/definitions/routerService"
        },
        "gifs": {
          "$ref": "#/definitions/routerService"
        },
        "unfurl": {
          "$ref": "#/definitions/routerService"
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "commonLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiVersion": {
          "type": "string",
          "enum": [
            "gateway.networking.k8s.io/v1",
            "gateway.networking.k8s.io/v1beta1"
          ]
        },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "namespace": {
                "type": "string"
              },
              "sectionName": {
                "type": "string"
              },
              "port": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "kind": {
                "type": "string"
              },
              "group": {
                "type": "string"
              }
            }
          }
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "labels": {
          "type": "object"
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            },
            "backendRequest": {
              "type": "string"
            }
          }
        },
        "staticPrefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "extraRules": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  },
  "definitions": {
    "quantity": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)?(Ei|Pi|Ti|Gi|Mi|Ki|E|P|T|G|M|k|m)?$"
    },
    "storage": {
      "type": "object",
      "properties": {
        "size": {
          "$ref": "#/definitions/quantity"
        },
        "storageClass": {
          "type": "string"
        }
      }
    },
    "backingService": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "storage": {
          "$ref": "#/definitions/storage"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "podCommon": {
      "resources": {
        "type": "object"
      },
      "nodeSelector": {
        "type": "object"
      },
      "tolerations": {
        "type": "array"
      },
      "affinity": {
        "type": "object"
      },
      "podAnnotations": {
        "type": "object"
      },
      "extraEnv": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "name"
          ]
        }
      }
    },
    "appService": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "logLevel": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    },
    "routerService": {
      "type": "object",
      "properties": {
        "routerReplicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        }
      }
    }
  }
}
